---
import Mesh from '../ui/Mesh.astro';
import { siteLinks } from '../../config/site-links';

const { heroPrimary, heroSecondary } = siteLinks.ctas;
---

<section class="hero" aria-labelledby="hero-title">
	<Mesh />
	<div class="hero__inner" data-reveal="">
		<p class="hero__eyebrow">Developer Documentation</p>
		<h1 id="hero-title" class="hero__title">Build what helps merchants thrive.</h1>
		<p class="hero__sub">
			APIs, MCPs (Soon!), integrations, tools, and resources. Everything you need to connect and ship with Convesio.
		</p>
		<div class="hero__ctas">
			<a class="btn btn--lg" href={heroPrimary.href}>{heroPrimary.label}</a>
			<a class="btn btn--lg btn--secondary" href={heroSecondary.href}>{heroSecondary.label}</a>
		</div>
	</div>
</section>

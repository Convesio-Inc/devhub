---
interface Props {
	/** Nodes per 1920 by 900 area, before the cap in mesh.ts. Leave unset for the default there. */
	density?: number;
}

const { density } = Astro.props;
---

<div class="mesh">
	<canvas data-mesh={density ?? ''} aria-hidden="true"></canvas>
</div>

<script>
	import { initMesh } from '../../scripts/mesh';

	initMesh();
</script>

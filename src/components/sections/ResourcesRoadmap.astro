---
import { siteLinks } from '../../config/site-links';
---

<section class="section" id="resources" aria-labelledby="resources-title">
	<div class="section__head" data-reveal="">
		<h2 id="resources-title" class="section__title">Resources</h2>
		<p class="section__lead">
			Planned destinations—swap these links in one config file as pages go live.
		</p>
	</div>
	<div class="roadmap-grid" data-reveal="stagger">
		{siteLinks.roadmap.map((item) => (
			<div class="roadmap-card">
				<span class="card__label">Upcoming</span>
				<strong class="card__title">{item.label}</strong>
				<a class="btn btn--secondary" href={item.href}>
					Open
				</a>
			</div>
		))}
	</div>
</section>

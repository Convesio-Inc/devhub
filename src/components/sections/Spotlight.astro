---
import { siteLinks } from '../../config/site-links';

const { convesioPay } = siteLinks.spotlight;

/* `tint` names a product colour token in global.css. `viz` names a graphic in scripts/viz.ts. */
const apis = [
	{
		id: 'spotlight-pay',
		title: 'ConvesioPay',
		text: 'Enterprise-grade payments with developer-friendly flows—designed to pair with your commerce stack on Convesio.',
		link: convesioPay,
		tint: 'pay',
		viz: 'pay',
	},
];
---

<section class="section section--muted" id="featured-apis" aria-labelledby="spotlight-title">
	<div class="section__head" data-reveal="">
		<h2 id="spotlight-title" class="section__title">Featured APIs</h2>
	</div>
	<div class="tools" data-reveal="stagger">
		{apis.map((api) => (
			<a
				class="tool"
				id={api.id}
				href={api.link.href}
				style={`--tint:var(--${api.tint})`}
				{...(api.link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
			>
				<div class="tool__viz" data-viz={api.viz} aria-hidden="true" />
				<div class="tool__text">
					<div class="tool__body">
						<h3>{api.title}</h3>
						<p>{api.text}</p>
					</div>
					<div class="tool__foot">{api.link.label}</div>
				</div>
			</a>
		))}
	</div>
</section>

<script>
	import { initViz } from '../../scripts/viz';

	initViz();
</script>

---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Convesio — Developer resources',
	description =
		'Commerce enablement, APIs, MCPs, integrations, and resources for teams building on Convesio.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="theme-color" content="#0B111E" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<script is:inline>
			// Dark unless the reader chose light. Runs before paint so the page never flashes.
			(function () {
				var root = document.documentElement;
				root.classList.add('js');
				try {
					if (localStorage.getItem('convesio-dev-theme') === 'light') {
						root.setAttribute('data-theme', 'light');
						document.querySelector('meta[name="theme-color"]').setAttribute('content', '#FFFFFF');
					}
				} catch (e) {}
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<slot />
	</body>
</html>
